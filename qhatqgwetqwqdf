local function promptInfo(prompt)
	local result = {
		prompt.Name,
		prompt.ActionText or "",
		prompt.ObjectText or ""
	}

	local current = prompt.Parent
	local depth = 0

	while current and current ~= workspace and depth < 10 do
		table.insert(result, current.Name)

		current = current.Parent
		depth += 1
	end

	return string.lower(
		table.concat(result, " ")
	)
end

local function setupPrompt(prompt)
	if not prompt or not prompt.Parent then
		return
	end

	pcall(function()
		prompt.MaxActivationDistance = 1000000
		prompt.RequiresLineOfSight = false
		prompt.HoldDuration = 0
	end)
end

local function triggerPrompt(prompt)
	if not prompt then
		return false
	end

	if not prompt.Parent then
		return false
	end

	if not prompt.Enabled then
		return false
	end

	setupPrompt(prompt)

	if typeof(fireproximityprompt) == "function" then
		return pcall(function()
			fireproximityprompt(prompt)
		end)
	end

	return pcall(function()
		prompt:InputHoldBegin()

		task.wait(0.005)

		prompt:InputHoldEnd()
	end)
end

local function teleportToPrompt(prompt)
	local character = getCharacter()
	local part = getPromptPart(prompt)

	if not character or not part then
		return false
	end

	return pcall(function()
		character:PivotTo(
			part.CFrame
				* CFrame.new(
					0,
					2.6,
					2
				)
		)
	end)
end

local function teleportAndUsePrompt(prompt)
	if not prompt or not prompt.Parent then
		return false
	end

	teleportToPrompt(prompt)

	task.wait(0.08)

	return triggerPrompt(prompt)
end

local function guiVisible(object)
	local current = object

	while current do
		if current:IsA("GuiObject") then
			if not current.Visible then
				return false
			end
		end

		if current == playerGui then
			break
		end

		current = current.Parent
	end

	return true
end

local function getGuiText(object)
	local result = {
		object.Name
	}

	if
		object:IsA("TextLabel")
		or object:IsA("TextButton")
		or object:IsA("TextBox")
	then
		table.insert(
			result,
			object.Text or ""
		)
	end

	for _, child in ipairs(object:GetDescendants()) do
		if
			child:IsA("TextLabel")
			or child:IsA("TextButton")
		then
			if child.Text ~= "" then
				table.insert(
					result,
					child.Text
				)
			end
		end
	end

	return string.lower(
		table.concat(result, " ")
	)
end

local function pressButton(button)
	if not button or not button.Parent then
		return false
	end

	if typeof(firesignal) == "function" then
		local success = pcall(function()
			firesignal(button.Activated)
		end)

		if success then
			return true
		end

		success = pcall(function()
			firesignal(
				button.MouseButton1Click
			)
		end)

		if success then
			return true
		end
	end

	if VirtualInputManager then
		local position = button.AbsolutePosition
		local size = button.AbsoluteSize

		local x =
			position.X
			+ (size.X / 2)

		local y =
			position.Y
			+ (size.Y / 2)

		return pcall(function()
			VirtualInputManager:
				SendMouseButtonEvent(
					x,
					y,
					0,
					true,
					game,
					0
				)

			task.wait(0.02)

			VirtualInputManager:
				SendMouseButtonEvent(
					x,
					y,
					0,
					false,
					game,
					0
				)
		end)
	end

	return false
end

local function findGuiButtonContaining(text)
	text = string.lower(text)

	for _, object in ipairs(playerGui:GetDescendants()) do
		if object:IsA("GuiButton") and guiVisible(object) then
			local info = getGuiText(object)

			if string.find(
				info,
				text,
				1,
				true
			) then
				return object
			end
		end
	end
end

local function getOwnFarm()
	local farms =
		workspace:FindFirstChild("Farm")
		or workspace:FindFirstChild("Farms")

	if not farms then
		return nil
	end

	for _, farm in ipairs(farms:GetChildren()) do
		local important =
			farm:FindFirstChild("Important")

		local data =
			important
			and important:FindFirstChild("Data")

		local owner =
			data
			and data:FindFirstChild("Owner")

		if owner then
			local success, value =
				pcall(function()
					return owner.Value
				end)

			if success then
				if value == player then
					return farm
				end

				if tostring(value) == player.Name then
					return farm
				end

				if tostring(value) == tostring(player.UserId) then
					return farm
				end
			end
		end
	end

	return nil
end

local function getOwnPlants()
	local farm = getOwnFarm()

	if not farm then
		return nil
	end

	local important =
		farm:FindFirstChild("Important")

	if not important then
		return nil
	end

	return important:
		FindFirstChild("Plants_Physical")
end

