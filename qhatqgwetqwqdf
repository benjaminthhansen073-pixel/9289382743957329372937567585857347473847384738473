local function findEmotePanel()
	local best
	local bestCount =
		math.huge

	for _, object in ipairs(playerGui:GetDescendants()) do
		if
			(
				object:IsA("TextLabel")
				or object:IsA("TextButton")
			)
			and guiVisible(object)
		then
			local text =
				string.lower(
					object.Text or ""
				)

			if string.find(
				text,
				"emotes",
				1,
				true
			) then
				local current =
					object.Parent

				local depth = 0

				while
					current
					and current ~= playerGui
					and depth < 6
				do
					local count = 0

					for _, item in ipairs(
						current:GetDescendants()
					) do
						if
							item:IsA("GuiButton")
							and guiVisible(item)
						then
							count += 1
						end
					end

					if
						count >= 4
						and count < bestCount
					then
						best = current
						bestCount = count
					end

					if current:IsA("ScreenGui") then
						break
					end

					current =
						current.Parent

					depth += 1
				end
			end
		end
	end

	return best
end

local function getEmoteButtons()
	local panel =
		findEmotePanel()

	if not panel then
		return {}
	end

	local buttons = {}

	for _, object in ipairs(panel:GetDescendants()) do
		if
			object:IsA("GuiButton")
			and guiVisible(object)
		then
			local info =
				getGuiText(object)

			if
				not string.find(
					info,
					"pets",
					1,
					true
				)
				and not string.find(
					info,
					"close",
					1,
					true
				)
			then
				local image

				if object:IsA("ImageButton") then
					image =
						object.Image
				else
					local imageObject =
						object:
							FindFirstChildWhichIsA(
								"ImageLabel",
								true
							)

					if imageObject then
						image =
							imageObject.Image
					end
				end

				if image and image ~= "" then
					table.insert(
						buttons,
						object
					)
				end
			end
		end
	end

	table.sort(
		buttons,
		function(a, b)
			local ay =
				a.AbsolutePosition.Y

			local by =
				b.AbsolutePosition.Y

			if math.abs(ay - by) > 5 then
				return ay < by
			end

			return
				a.AbsolutePosition.X
				< b.AbsolutePosition.X
		end
	)

	return buttons
end

local emoteIndex = 0

local function sendNextEmote()
	local buttons =
		getEmoteButtons()

	if #buttons == 0 then
		openEmotes()

		task.wait(0.15)

		buttons =
			getEmoteButtons()
	end

	if #buttons == 0 then
		return false
	end

	emoteIndex += 1

	if emoteIndex > #buttons then
		emoteIndex = 1
	end

	return pressButton(
		buttons[emoteIndex]
	)
end

