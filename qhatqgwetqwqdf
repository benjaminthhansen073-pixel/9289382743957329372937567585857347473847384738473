local function slider(
	parent,
	title,
	minimum,
	maximum,
	default,
	callback
)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 78)
	card.BackgroundColor3 = Theme.Card
	card.BorderSizePixel = 0
	card.Parent = parent

	corner(card, 9)
	stroke(card)

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -75, 0, 20)
	titleLabel.Position = UDim2.fromOffset(14, 11)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamSemibold
	titleLabel.Text = title
	titleLabel.TextColor3 = Theme.Text
	titleLabel.TextSize = 12
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = card

	local valueLabel = Instance.new("TextLabel")
	valueLabel.Size = UDim2.fromOffset(52, 22)
	valueLabel.Position = UDim2.new(1, -66, 0, 10)
	valueLabel.BackgroundColor3 = Color3.fromRGB(29, 32, 39)
	valueLabel.BorderSizePixel = 0
	valueLabel.Font = Enum.Font.GothamSemibold
	valueLabel.Text = tostring(default)
	valueLabel.TextColor3 = Theme.Accent
	valueLabel.TextSize = 10
	valueLabel.Parent = card
	corner(valueLabel, 6)

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -28, 0, 5)
	track.Position = UDim2.fromOffset(14, 52)
	track.BackgroundColor3 = Color3.fromRGB(42, 46, 55)
	track.BorderSizePixel = 0
	track.Parent = card
	corner(track, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(
		(default - minimum) / (maximum - minimum),
		0,
		1,
		0
	)
	fill.BackgroundColor3 = Theme.Accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	corner(fill, 6)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(13, 13)
	knob.Position = UDim2.new(
		(default - minimum) / (maximum - minimum),
		0,
		0.5,
		0
	)
	knob.BackgroundColor3 = Theme.Text
	knob.BorderSizePixel = 0
	knob.Parent = track
	corner(knob, 10)

	local dragging = false

	local function update(input)
		local x = math.clamp(
			input.Position.X - track.AbsolutePosition.X,
			0,
			track.AbsoluteSize.X
		)

		local percentage = x / track.AbsoluteSize.X

		local value = math.floor(
			minimum +
			((maximum - minimum) * percentage)
		)

		fill.Size = UDim2.new(percentage, 0, 1, 0)
		knob.Position = UDim2.new(percentage, 0, 0.5, 0)
		valueLabel.Text = tostring(value)

		callback(value)
	end

	track.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = true
			update(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			update(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			dragging = false
		end
	end)
end

