local function findShopPrompt(words)
	for _, prompt in ipairs(workspace:GetDescendants()) do
		if
			prompt:IsA("ProximityPrompt")
			and prompt.Enabled
		then
			local action =
				string.lower(prompt.ActionText or "")

			if
				string.find(
					action,
					"open",
					1,
					true
				)
				or action == ""
			then
				local info =
					promptInformation(prompt)

				local correct = true

				for _, word in ipairs(words) do
					if
						not string.find(
							info,
							string.lower(word),
							1,
							true
						)
					then
						correct = false
						break
					end
				end

				if correct then
					return prompt
				end
			end
		end
	end
end

local function openShop(name)
	local searches = {
		Gear = {
			{"gear", "shop"},
			{"gear"},
		},

		Furniture = {
			{"furniture"},
		},

		Market = {
			{"farmers", "market"},
			{"farmer", "market"},
			{"market"},
		},

		Pets = {
			{"pet", "shop"},
			{"pets"},
			{"pet"},
		},
	}

	local list = searches[name]

	if not list then
		return false
	end

	for _, words in ipairs(list) do
		local prompt = findShopPrompt(words)

		if prompt then
			return usePrompt(prompt)
		end
	end

	return false
end

