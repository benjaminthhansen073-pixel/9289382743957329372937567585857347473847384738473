local function switchPage(
	name,
	title,
	subtitle
)
	for pageName, page in pairs(Pages) do
		page.Visible =
			pageName == name
	end

	for pageName, button in pairs(NavButtons) do
		local selected =
			pageName == name

		tween(button, 0.15, {
			BackgroundColor3 =
				selected
				and Theme.AccentDark
				or Theme.Sidebar,
		})

		button.TextColor3 =
			selected
				and Theme.Accent
				or Theme.SubText
	end

	PageTitle.Text = title
	PageSub.Text = subtitle
end

