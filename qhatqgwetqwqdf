local function harvestAll()
	local prompts = getCollectPrompts()

	if #prompts == 0 then
		return
	end

	local character = getCharacter()
	local root = getRoot()

	if not character or not root then
		return
	end

	local oldPosition = character:GetPivot()

	local platform = Instance.new("Part")

	platform.Name = "GridiHarvestPlatform"

	platform.Size = Vector3.new(
		6,
		0.5,
		6
	)

	platform.Anchored = true
	platform.CanCollide = true

	platform.CanTouch = false
	platform.CanQuery = false

	platform.Transparency = 0.3
	platform.Color = Theme.Accent

	platform.Parent = workspace

	for _, prompt in ipairs(prompts) do
		if not State.AutoHarvest then
			break
		end

		if prompt.Parent and prompt.Enabled then
			local part = getPromptPart(prompt)

			if part then
				platform.CFrame =
					part.CFrame
					* CFrame.new(
						0,
						-3,
						0
					)

				pcall(function()
					character:PivotTo(
						platform.CFrame
							* CFrame.new(
								0,
								3.2,
								0
							)
					)
				end)

				task.wait(0.015)

				firePrompt(prompt)

				task.wait(0.025)
			end
		end
	end

	if platform then
		platform:Destroy()
	end

	if character and character.Parent then
		pcall(function()
			character:PivotTo(oldPosition)
		end)
	end
end

