local function unloadEverything()
	if State.Unloading then
		return
	end

	State.Unloading = true

	State.AutoBuy = false
	State.AutoHarvest = false
	State.AutoSell = false

	State.EmoteSpam = false
	State.AntiAFK = false

	State.Fly = false
	State.WalkSpeed = false

	stopFly()

	local humanoid =
		getHumanoid()

	if humanoid then
		pcall(function()
			humanoid.WalkSpeed = 16
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end)
	end

	if harvestPlatform then
		pcall(function()
			harvestPlatform:Destroy()
		end)

		harvestPlatform = nil
	end

	if idleConnection then
		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection = nil
	end

	_G.THHGrowersHardUnloaded = true

	_G.THHGrowersCleanup = nil
	_G.GridiGrowersCleanup = nil

	task.wait(0.1)

	if screen and screen.Parent then
		screen:Destroy()
	end
end

