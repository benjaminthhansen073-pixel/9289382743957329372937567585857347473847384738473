local function findShopPrompt(kind)
	local searches = ShopSearches[kind]

	if not searches then
		return nil
	end

	for _, words in ipairs(searches) do
		for _, prompt in ipairs(workspace:GetDescendants()) do
			if
				prompt:IsA("ProximityPrompt")
				and prompt.Enabled
			then
				local info = promptInfo(prompt)
				local matches = true

				for _, word in ipairs(words) do
					if not string.find(
						info,
						string.lower(word),
						1,
						true
					) then
						matches = false
						break
					end
				end

				if matches then
					return prompt
				end
			end
		end
	end
end

