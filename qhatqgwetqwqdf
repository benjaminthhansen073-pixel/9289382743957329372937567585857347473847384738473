local function switchPage(
	name,
	title,
	subtitle
)
	for pageName, page in pairs(pages) do
		page.Visible =
			pageName == name
	end

	for pageName, button in pairs(navButtons) do
		local selected =
			pageName == name

		button.BackgroundColor3 =
			selected
				and Theme.AccentDark
				or Theme.Sidebar

		button.TextColor3 =
			selected
				and Theme.Accent
				or Theme.SubText
	end

	pageTitle.Text = title
	pageSub.Text = subtitle
end

