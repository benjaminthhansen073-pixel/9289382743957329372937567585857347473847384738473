							)
						then
							return current
						end

						current =
							current.Parent
					end
				end
			end
		end
	end

	for _, object in ipairs(
		playerGui:GetDescendants()
	) do
		if
			object:IsA("GuiButton")
			and guiVisible(object)
		then
