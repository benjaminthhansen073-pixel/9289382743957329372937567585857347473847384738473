local function findPart(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Model") then
		return object.PrimaryPart
			or object:FindFirstChild("HumanoidRootPart")
			or object:FindFirstChild("Head")
			or object:FindFirstChildWhichIsA("BasePart", true)
	end

	return object:FindFirstChildWhichIsA("BasePart", true)
end

local SHOP_TERMS = {
	Gear = {"gear shop", "gear"},
	Furniture = {"furniture", "furn"},
	Market = {"farmers market", "farmer", "market"},
	Pets = {"pet shop", "pets", "pet"}
}

local function findShopPrompt(shopName)
	local terms = SHOP_TERMS[shopName]

	if not terms then
		return nil
	end

	local bestPrompt
	local bestScore = -1

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("ProximityPrompt") and object.Enabled then
			local action = string.lower(object.ActionText or "")

			if string.find(action, "open", 1, true) then
				local context = promptContext(object)
				local score = 0

				for index, term in ipairs(terms) do
					if string.find(context, term, 1, true) then
						score += (#terms - index + 1) * 3
					end
				end

				local objectText = string.lower(object.ObjectText or "")
				if objectText ~= "" and hasWord(objectText, terms) then
					score += 8
				end

				if score > bestScore then
					bestScore = score
					bestPrompt = object
				end
			end
	end

	if bestScore <= 0 then
		return nil
	end

	return bestPrompt
end

local function openShop(shopName)
	local prompt = findShopPrompt(shopName)

	if not prompt then
