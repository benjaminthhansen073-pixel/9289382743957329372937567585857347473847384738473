_G.GridiGrowersCleanup = function()
	State.AutoBuy = false
	State.AutoHarvest = false
	State.AutoSell = false
	State.AntiIdle = false
	State.Fly = false

	pcall(stopFly)

	if antiIdleConnection then
		pcall(function()
			antiIdleConnection:Disconnect()
		end)
	end

	if screen and screen.Parent then
		pcall(function()
			screen:Destroy()
		end)
	end
end
