local function flyToHarvestPrompt(prompt)
	if
		not State.AutoHarvest
		or State.Unloading
		or selling
	then
		return false
	end

	if not prompt or not prompt.Parent then
		return false
	end

	local character =
		getCharacter()

	local root =
		getRoot()

	local humanoid =
		getHumanoid()

	local part =
		getPromptPart(prompt)

	if
		not character
		or not root
		or not humanoid
		or not part
	then
		return false
	end

	local destination =
		part.CFrame
		* CFrame.new(
			0,
			2.5,
			1.2
		)

	local distance =
		(
			root.Position
			- destination.Position
		).Magnitude

	local duration =
		math.clamp(
			distance / 95,
			0.08,
			1.5
		)

	local oldPlatformStand =
		humanoid.PlatformStand

	local oldAutoRotate =
		humanoid.AutoRotate

	pcall(function()
		root.AssemblyLinearVelocity =
			Vector3.zero

		root.AssemblyAngularVelocity =
			Vector3.zero

		humanoid.PlatformStand = true
		humanoid.AutoRotate = false
	end)

	local movement =
		TweenService:Create(
			root,
			TweenInfo.new(
				duration,
				Enum.EasingStyle.Linear,
				Enum.EasingDirection.Out
			),
			{
				CFrame = destination
			}
		)

	local finished = false

	local completed =
		movement.Completed:
			Connect(function()
				finished = true
			end)

	movement:Play()

	local started =
		os.clock()

	while
		not finished
		and root.Parent
		and os.clock() - started
			< duration + 0.5
	do
		if
			not State.AutoHarvest
			or State.Unloading
			or selling
		then
			pcall(function()
				movement:Cancel()
			end)

			break
		end

		RunService.Heartbeat:Wait()
	end

	completed:Disconnect()

	if
		humanoid
		and humanoid.Parent
	then
		if State.Fly then
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false
		else
			humanoid.PlatformStand =
				oldPlatformStand

			humanoid.AutoRotate =
				oldAutoRotate
		end
	end

	if
		not State.AutoHarvest
		or State.Unloading
		or selling
	then
		return false
	end

	return true
end

local function getSortedHarvestPrompts()
	local root =
		getRoot()

	if not root then
		return {}
	end

	local list = {}

	for prompt in pairs(harvestPrompts) do
		if
			prompt
			and prompt.Parent
			and prompt.Enabled
			and watchedPlants
			and prompt:IsDescendantOf(
				watchedPlants
			)
		then
			local part =
				getPromptPart(prompt)

			if part then
				table.insert(
					list,
					{
						Prompt = prompt,
						Distance =
							(
								root.Position
								- part.Position
							).Magnitude
					}
				)
			end
		else
			if not prompt.Parent then
				harvestPrompts[prompt] = nil
			end
		end
	end

	table.sort(
		list,
		function(a, b)
			return
				a.Distance
				< b.Distance
		end
	)

	return list
end

local function harvestOwnCrops()
	if harvesting then
		return
	end

	if
		not State.AutoHarvest
		or State.Unloading
		or selling
	then
		return
	end

	harvesting = true

	local success =
		pcall(function()

			watchOwnPlants()

			if
				not watchedPlants
				or not watchedPlants.Parent
			then
				return
			end

			local prompts =
				getSortedHarvestPrompts()

			for _, data in ipairs(prompts) do
				if
					not State.AutoHarvest
					or State.Unloading
					or selling
				then
					break
				end

				local prompt =
					data.Prompt

				if
					prompt
					and prompt.Parent
					and prompt.Enabled
					and prompt:IsDescendantOf(
						watchedPlants
					)
				then
					local moved =
						flyToHarvestPrompt(
							prompt
						)

					if
						moved
						and prompt.Parent
						and prompt.Enabled
					then
						setupPrompt(
							prompt
						)

						triggerPrompt(
							prompt
						)

						task.wait(0.035)

						if
							prompt.Parent
							and prompt.Enabled
						then
							triggerPrompt(
								prompt
							)
						end

						task.wait(0.055)
					end
				end
			end
		end)

	harvesting = false

	return success
end

local function spamOwnHarvest()
	return harvestOwnCrops()
end

