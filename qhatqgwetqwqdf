local function isHarvestPrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return false
	end

	local action =
		string.lower(
			prompt.ActionText or ""
		)

	local objectText =
		string.lower(
			prompt.ObjectText or ""
		)

	local info =
		promptInfo(prompt)

	if string.find(
		action,
		"collect",
		1,
		true
	) then
		return true
	end

	if string.find(
		action,
		"harvest",
		1,
		true
	) then
		return true
	end

	if string.find(
		action,
		"pick",
		1,
		true
	) then
		return true
	end

	if string.find(
		objectText,
		"collect",
		1,
		true
	) then
		return true
	end

	if string.find(
		info,
		"collect",
		1,
		true
	) then
		return true
	end

	if string.find(
		info,
		"harvest",
		1,
		true
	) then
		return true
	end

	return false
end

local function addHarvestPrompt(prompt)
	if not watchedPlants then
		return
	end

	if not prompt or not prompt.Parent then
		return
	end

	if not prompt:IsDescendantOf(watchedPlants) then
		return
	end

	if not isHarvestPrompt(prompt) then
		return
	end

	harvestPrompts[prompt] = true

	setupPrompt(prompt)
end

local function clearPlantConnections()
	if plantsAddedConnection then
		pcall(function()
			plantsAddedConnection:
				Disconnect()
		end)

		plantsAddedConnection = nil
	end

	if plantsRemovingConnection then
		pcall(function()
			plantsRemovingConnection:
				Disconnect()
		end)

		plantsRemovingConnection = nil
	end
end

local function watchOwnPlants()
	local plants =
		getOwnPlants()

	if plants == watchedPlants then
		return
	end

	clearPlantConnections()

	table.clear(
		harvestPrompts
	)

	watchedPlants = plants

	if not watchedPlants then
		return
	end

	for _, object in ipairs(
		watchedPlants:GetDescendants()
	) do
		if object:IsA("ProximityPrompt") then
			addHarvestPrompt(object)
		end
	end

	plantsAddedConnection =
		watchedPlants.DescendantAdded:
			Connect(function(object)

				if object:IsA("ProximityPrompt") then
					task.defer(function()
						addHarvestPrompt(
							object
						)
					end)

					task.delay(
						0.1,
						function()
							if object.Parent then
								addHarvestPrompt(
									object
								)
							end
						end
					)
				end
			end)

	plantsRemovingConnection =
		watchedPlants.DescendantRemoving:
			Connect(function(object)

				if harvestPrompts[object] then
					harvestPrompts[object] = nil
				end
			end)
end

