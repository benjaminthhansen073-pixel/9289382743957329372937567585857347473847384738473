				)
			then
				local image

				if object:IsA("ImageButton") then
					image = object.Image
				else
					local img =
						object:
							FindFirstChildWhichIsA(
								"ImageLabel",
								true
							)

					if img then
						image = img.Image
					end
				end

				if image and image ~= "" then
					table.insert(result, object)
				end
			end
		end
	end

	return result
end

local emoteIndex = 0

local function sendNextEmote()
	local buttons = findEmoteButtons()

	if #buttons == 0 then
		openEmotes()

		task.wait(0.15)

		buttons = findEmoteButtons()
	end

	if #buttons == 0 then
		return false
	end

	emoteIndex += 1

	if emoteIndex > #buttons then
		emoteIndex = 1
	end

	return pressButton(
		buttons[emoteIndex]
	)
end

