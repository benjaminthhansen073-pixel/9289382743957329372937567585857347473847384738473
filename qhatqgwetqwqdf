local function unlock()
	if State.Unlocked then
		return
	end

	if KeyBox.Text ~= KEY then
		KeyStatus.Text =
			"Invalid access key"

		KeyStatus.TextColor3 =
			Theme.Danger

		local original =
			KeyBox.Position

		tween(KeyBox, 0.06, {
			Position =
				original
				+ UDim2.fromOffset(
					-5,
					0
				),
		})

		task.wait(0.06)

		tween(KeyBox, 0.06, {
			Position =
				original
				+ UDim2.fromOffset(
					5,
					0
				),
		})

		task.wait(0.06)

		tween(KeyBox, 0.06, {
			Position = original,
		})

		return
	end

	State.Unlocked = true

	KeyStatus.Text =
		"Access granted"

	KeyStatus.TextColor3 =
		Theme.Accent

	Continue.Text =
		"Unlocked"

	task.wait(0.25)

	KeyWindow.Visible = false
	Main.Visible = true

	Main.Size =
		UDim2.fromOffset(
			650,
			420
		)

	Main.BackgroundTransparency = 1

	tween(Main, 0.27, {
		Size =
			UDim2.fromOffset(
				700,
				455
			),

		BackgroundTransparency = 0,
	})

	notify(
		"Gridi Growers",

		"Welcome, "
			.. player.DisplayName
			.. "."
	)
end

Continue.MouseButton1Click:Connect(
	unlock
)

KeyBox.FocusLost:Connect(function(enterPressed)
