local function getSeedsInStock()
	local shop = getSeedShop()

	if not shop then
		return {}
	end

	local list = {}
	local found = {}

	for _, frame in ipairs(shop:GetDescendants()) do
		if frame.Name == "Main_Frame" then
			local item = frame.Parent

			if item and not found[item] then
				local stockLabel = frame:FindFirstChild("Stock_Text", true)

				if stockLabel and stockLabel:IsA("TextLabel") then
					local text = stockLabel.Text or ""
					local amount = tonumber(text:match("[xX]%s*(%d+)"))
						or tonumber(text:match("(%d+)"))
						or 0

					if amount > 0 then
						found[item] = true
						table.insert(list, {
							Name = item.Name,
							Stock = amount
						})
					end
				end
			end
		end
	end

	return list
end

local function promptPart(prompt)
	local parent = prompt.Parent

	while parent do
		if parent:IsA("BasePart") then
			return parent
		end

		parent = parent.Parent
	end
end

local function promptContext(prompt)
	local text = {
		prompt.ActionText or "",
		prompt.ObjectText or ""
	}

	local node = prompt.Parent
	local depth = 0

	while node and node ~= workspace and depth < 8 do
		table.insert(text, node.Name)
		node = node.Parent
		depth += 1
	end

	local scope = prompt.Parent and prompt.Parent.Parent
	local added = 0

	if scope then
		for _, object in ipairs(scope:GetDescendants()) do
			if added >= 24 then
				break
			end

			if object:IsA("TextLabel") or object:IsA("TextButton") then
				local value = object.Text

				if value and value ~= "" then
					table.insert(text, value)
					added += 1
				end
			end
		end
	end

	return string.lower(table.concat(text, " "))
end

local function hasWord(text, words)
	for _, word in ipairs(words) do
		if string.find(text, string.lower(word), 1, true) then
			return true
		end
	end

	return false
end

local function firePrompt(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	if typeof(fireproximityprompt) == "function" then
		return pcall(function()
			fireproximityprompt(prompt)
		end)
	end

	return pcall(function()
		prompt:InputHoldBegin()
		task.wait(math.max(prompt.HoldDuration, 0.025) + 0.015)
		prompt:InputHoldEnd()
	end)
end

local function usePrompt(prompt, moveToPrompt, returnAfter)
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end

	local character = getCharacter()
	local part = promptPart(prompt)
	local oldPosition

	if moveToPrompt and character and part then
		oldPosition = character:GetPivot()

		pcall(function()
			character:PivotTo(part.CFrame * CFrame.new(0, 2.4, 2))
		end)

		task.wait(0.045)
	end

	local ok = firePrompt(prompt)

	if returnAfter and oldPosition and character and character.Parent then
		task.wait(0.035)

		pcall(function()
			character:PivotTo(oldPosition)
		end)
	end

	return ok
end

local function getWorldSeedPrompts()
	local prompts = {}

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("ProximityPrompt") and object.Enabled then
			local action = string.lower(object.ActionText or "")

			if string.find(action, "buy", 1, true) then
				local context = promptContext(object)

				if string.find(context, "seed", 1, true) then
					table.insert(prompts, object)
				end
			end
		end
	end

	return prompts
end

local function buyStock()
	local physicalSeeds = getWorldSeedPrompts()

	if #physicalSeeds > 0 then
		for _, prompt in ipairs(physicalSeeds) do
			if not State.AutoBuy then
				break
			end

			usePrompt(prompt, typeof(fireproximityprompt) ~= "function", true)
			task.wait(0.045)
		end

		return
	end

	local remote = getRemote("BuySeedStock")

	if not remote then
		return
	end

	for _, seed in ipairs(getSeedsInStock()) do
		if not State.AutoBuy then
			break
		end

		for _ = 1, seed.Stock do
			if not State.AutoBuy then
				break
			end

			pcall(function()
				remote:FireServer(seed.Name)
			end)

			task.wait(0.055)
		end
	end
end

