local function sellInventory()
	if selling or State.Unloading then
		return false
	end

	selling = true

	local root =
		getRoot()

	local returnCFrame =
		root
		and root.CFrame

	local sold = false

	local success =
		pcall(function()

			local prompt =
				findSellerPrompt()

			if prompt and prompt.Parent then
				teleportToPrompt(
					prompt
				)

				task.wait(0.15)

				for _ = 1, 5 do
					if State.Unloading then
						break
					end

					setupPrompt(
						prompt
					)

					triggerPrompt(
						prompt
					)

					task.wait(0.12)

					local clicked =
						clickSellDialogue()

					if clicked then
						sold = true

						task.wait(0.2)

						break
					end
				end
			end

			if not sold then
				local button =
					findSellInventoryButton()

				if button then
					if
						pressButton(
							button
						)
					then
						sold = true

						task.wait(0.15)
					end
				end
			end

			if not sold then
				local sellRemote =
					getRemote(
						"Sell_Inventory"
					)

				if sellRemote then
					local remoteSuccess =
						pcall(function()
							sellRemote:
								FireServer()
						end)

					if remoteSuccess then
						sold = true
					end
				end
			end
		end)

	task.wait(0.15)

	if returnCFrame then
		returnToPosition(
			returnCFrame
		)
	end

	selling = false

	if not success then
		return false
	end

	return sold
end

