local function guiVisible(object)
	local current = object

	while current do
		if
			current:IsA("GuiObject")
			and not current.Visible
		then
			return false
		end

		if current == playerGui then
			break
		end

		current = current.Parent
	end

	return true
end

local function guiText(object)
	local result = {}

	table.insert(result, object.Name)

	if
		object:IsA("TextLabel")
		or object:IsA("TextButton")
		or object:IsA("TextBox")
	then
		table.insert(
			result,
			object.Text or ""
		)
	end

	for _, child in ipairs(object:GetDescendants()) do
		if
			child:IsA("TextLabel")
			or child:IsA("TextButton")
		then
			if child.Text ~= "" then
				table.insert(
					result,
					child.Text
				)
			end
		end
	end

	return string.lower(
		table.concat(result, " ")
	)
end

local function pressGuiButton(button)
	if not button or not button.Parent then
		return false
	end

	if typeof(firesignal) == "function" then
		local success = pcall(function()
			firesignal(button.Activated)
		end)

		if success then
			return true
		end

		success = pcall(function()
			firesignal(
				button.MouseButton1Click
			)
		end)

		if success then
			return true
		end
	end

	if VirtualInputManager then
		local position =
			button.AbsolutePosition

		local size =
			button.AbsoluteSize

		local x =
			position.X
			+ (size.X / 2)

		local y =
			position.Y
			+ (size.Y / 2)

		local success = pcall(function()
			VirtualInputManager:
				SendMouseButtonEvent(
					x,
					y,
					0,
					true,
					game,
					0
				)

			task.wait(0.02)

			VirtualInputManager:
				SendMouseButtonEvent(
					x,
					y,
					0,
					false,
					game,
					0
				)
		end)

		if success then
			return true
		end
	end

	return false
end

local function findOpenEmotesButton()
	local best

	for _, object in ipairs(playerGui:GetDescendants()) do
		if
			object:IsA("GuiButton")
			and guiVisible(object)
		then
			local text = guiText(object)

			if
				string.find(
					text,
					"emotes",
					1,
					true
				)
			then
				best = object
				break
			end
		end
	end

	return best
end

local function openEmotesMenu()
	local button =
		findOpenEmotesButton()

	if button then
		return pressGuiButton(button)
	end

	return false
end

local function findEmotePanel()
	local best
	local bestButtonCount = math.huge

	for _, object in ipairs(playerGui:GetDescendants()) do
		local isText =
			object:IsA("TextLabel")
			or object:IsA("TextButton")

		if
			isText
			and guiVisible(object)
		then
			local text =
				string.lower(object.Text or "")

			if
				string.find(
					text,
					"emotes",
					1,
					true
				)
			then
				local parent = object.Parent
				local depth = 0

				while
					parent
					and parent ~= playerGui
					and depth < 6
				do
					local buttons = 0

					for _, item in ipairs(
						parent:GetDescendants()
					) do
						if
							item:IsA("GuiButton")
							and guiVisible(item)
						then
							buttons += 1
						end
					end

					if
						buttons >= 4
						and buttons < bestButtonCount
					then
						best = parent
						bestButtonCount = buttons
					end

					if parent:IsA("ScreenGui") then
						break
					end

					parent = parent.Parent
					depth += 1
				end
			end
		end
	end

	return best
end

local function getEmoteButtons()
	local panel = findEmotePanel()

	if not panel then
		return {}
	end

	local buttons = {}

	for _, object in ipairs(panel:GetDescendants()) do
		if
			object:IsA("GuiButton")
			and guiVisible(object)
		then
			local text = guiText(object)

			-- Don't click the menu's title/open buttons.
			if
				not string.find(
					text,
					"pets",
					1,
					true
				)
				and not (
					string.find(
						text,
						"emotes",
						1,
						true
					)
					and (
						object:IsA("TextButton")
						and object.Text ~= ""
					)
				)
			then
				table.insert(
					buttons,
					object
				)
			end
		end
	end

	table.sort(buttons, function(a, b)
		local ay = a.AbsolutePosition.Y
		local by = b.AbsolutePosition.Y

		if math.abs(ay - by) > 5 then
			return ay < by
		end

		return
			a.AbsolutePosition.X
			< b.AbsolutePosition.X
	end)

	return buttons
end

local currentEmote = 0

local function sendNextEmote()
	local buttons = getEmoteButtons()

	if #buttons == 0 then
		openEmotesMenu()

		task.wait(0.15)

		buttons = getEmoteButtons()
	end

	if #buttons == 0 then
		return false
	end

	currentEmote += 1

	if currentEmote > #buttons then
		currentEmote = 1
	end

	local button =
		buttons[currentEmote]

	return pressGuiButton(button)
end

