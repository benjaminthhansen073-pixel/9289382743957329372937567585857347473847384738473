--========================================================

player.CharacterAdded:Connect(function()
	task.wait(0.8)

	if State.WalkSpeed then
		applyWalkSpeed()
	end

	if State.Fly then
		task.wait(0.3)
		startFly()
	end
end)

--========================================================
-- CLEANUP
--========================================================

_G.GridiGrowersCleanup = function()
	State.AutoBuy = false
	State.AutoHarvest = false
	State.AutoSell = false
	State.Fly = false
	State.AntiAFK = false
	State.EmoteSpam = false

	pcall(stopFly)

	if idleConnection then
		pcall(function()
			idleConnection:Disconnect()
		end)
	end

	if Screen and Screen.Parent then
		pcall(function()
			Screen:Destroy()
		end)
	end
end
