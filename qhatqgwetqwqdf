		description

	desc.TextColor3 =
		Theme.SubText

	desc.TextSize = 9

	desc.TextXAlignment =
		Enum.TextXAlignment.Left

	desc.Parent =
		card

	local box =
		Instance.new("TextBox")

	box.Size =
		UDim2.fromOffset(
			78,
			32
		)

	box.Position =
		UDim2.new(
			1,
			-91,
			0.5,
			-16
		)

	box.BackgroundColor3 =
		Color3.fromRGB(
			27,
			30,
			36
		)

	box.BorderSizePixel = 0
	box.ClearTextOnFocus = false

	box.Font =
		Enum.Font.GothamSemibold

	box.Text =
		tostring(default)

	box.TextColor3 =
		Theme.Accent

	box.TextSize = 10

	box.Parent =
		card

	corner(
		box,
		6
	)

	stroke(box)

	box.FocusLost:
		Connect(function()

			local value =
				tonumber(
					box.Text
				)

			if not value then
				box.Text =
					tostring(default)

				return
			end

			value =
				math.clamp(
					value,
					minimum,
					maximum
				)

			value =
				math.floor(
					value * 100
				) / 100

			box.Text =
				tostring(value)

			callback(value)
		end)

	return box
end

