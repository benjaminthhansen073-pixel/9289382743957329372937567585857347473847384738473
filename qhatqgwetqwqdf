local function getFarm()
	local farms =
		workspace:FindFirstChild("Farm")
		or workspace:FindFirstChild("Farms")

	if not farms then
		return nil
	end

	for _, farm in ipairs(farms:GetChildren()) do
		local important = farm:FindFirstChild("Important")

		local data =
			important
			and important:FindFirstChild("Data")

		local owner =
			data
			and data:FindFirstChild("Owner")

		if owner then
			local success, value = pcall(function()
				return owner.Value
			end)

			if success then
				if value == player then
					return farm
				end

				if tostring(value) == player.Name then
					return farm
				end
			end
		end
	end

	return nil
end

local function getPlants()
	local farm = getFarm()

	if not farm then
		return nil
	end

	local important = farm:FindFirstChild("Important")

	if important then
		return important:FindFirstChild("Plants_Physical")
	end
end

--========================================================
-- PROMPT HELPERS
--========================================================

local function getPromptPart(prompt)
	local current = prompt.Parent

	while current do
		if current:IsA("BasePart") then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function promptInformation(prompt)
	local result = {}

	table.insert(result, prompt.ActionText or "")
	table.insert(result, prompt.ObjectText or "")

	local current = prompt.Parent
	local depth = 0

	while current and current ~= workspace and depth < 8 do
		table.insert(result, current.Name)

		current = current.Parent
		depth += 1
	end

	return string.lower(
		table.concat(result, " ")
	)
end

local function firePrompt(prompt)
	if not prompt then
		return false
	end

	if not prompt.Parent then
		return false
	end

	if not prompt.Enabled then
		return false
	end

	if typeof(fireproximityprompt) == "function" then
		return pcall(function()
			fireproximityprompt(prompt)
		end)
	end

	return pcall(function()
		prompt:InputHoldBegin()

		task.wait(
			math.max(
				prompt.HoldDuration,
				0.03
			) + 0.02
		)

		prompt:InputHoldEnd()
	end)
end

local function usePrompt(prompt)
	if not prompt or not prompt.Parent then
		return false
	end

	if typeof(fireproximityprompt) == "function" then
		return firePrompt(prompt)
	end

	local character = getCharacter()
	local part = getPromptPart(prompt)

	if not character or not part then
		return false
	end

	local oldPosition = character:GetPivot()

	pcall(function()
		character:PivotTo(
			part.CFrame
				* CFrame.new(0, 2.5, 2)
		)
	end)

	task.wait(0.04)

	local success = firePrompt(prompt)

	task.wait(0.03)

	if character and character.Parent then
		pcall(function()
			character:PivotTo(oldPosition)
		end)
	end

	return success
end

