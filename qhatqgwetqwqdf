local function copyKeyLink()
	local copied = copyText(KEY_LINK)

	if copied then
		keyStatus.Text = "Key link copied to clipboard"
		keyStatus.TextColor3 = Theme.Accent

		getKeyButton.Text = "Copied"

		task.delay(1.5, function()
			if getKeyButton.Parent then
				getKeyButton.Text = "Get Access Key"
			end
		end)
	else
		keyStatus.Text = "Clipboard is not supported"
		keyStatus.TextColor3 = Theme.Danger
	end
end

local function unlock()
	if State.Unlocked then
		return
	end

	if keyBox.Text ~= KEY then
		keyStatus.Text = "Invalid access key"
		keyStatus.TextColor3 = Theme.Danger

		tween(keyBox, 0.1, {
			Position = UDim2.fromOffset(17, 135)
		})

		task.wait(0.1)

		tween(keyBox, 0.1, {
			Position = UDim2.fromOffset(27, 135)
		})

		task.wait(0.1)

		tween(keyBox, 0.1, {
			Position = UDim2.fromOffset(22, 135)
		})

		return
	end

	State.Unlocked = true

	keyStatus.Text = "Access granted"
	keyStatus.TextColor3 = Theme.Accent

	unlockButton.Text = "Unlocked"

	task.wait(0.35)

	tween(keyWindow, 0.25, {
		BackgroundTransparency = 1
	})

	task.wait(0.15)

	keyWindow.Visible = false
	main.Visible = true

	main.Size = UDim2.fromOffset(620, 400)
	main.BackgroundTransparency = 1

	tween(main, 0.3, {
		Size = UDim2.fromOffset(680, 440),
		BackgroundTransparency = 0
	})

	notify(
		"Gridi Growers",
		"Welcome, " .. player.DisplayName .. "."
	)
end

getKeyButton.MouseButton1Click:Connect(copyKeyLink)
unlockButton.MouseButton1Click:Connect(unlock)

keyBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		unlock()
	end
end)

