			)
		end

		task.wait(2)
	end
end)

task.spawn(function()
	while
		screen.Parent
		and not State.Unloading
	do
		if
			State.Unlocked
			and State.EmoteSpam
		then
			pcall(
				sendNextEmote
			)

			task.wait(
				State.EmoteDelay
			)
		else
			task.wait(0.1)
		end
	end
end)

player.CharacterAdded:
	Connect(function()

		task.wait(0.8)

		if State.Unloading then
			return
		end

		if State.WalkSpeed then
			applySpeed()
		end

		if State.Fly then
			task.wait(0.25)
			startFly()
		end
	end)

_G.THHGrowersCleanup = function()
	if State.Unloading then
		return
	end

	State.AutoBuy = false
	State.AutoHarvest = false
	State.AutoSell = false

	State.EmoteSpam = false
	State.AntiAFK = false

	State.Fly = false
	State.WalkSpeed = false

	pcall(stopFly)

	local humanoid =
		getHumanoid()

	if humanoid then
		pcall(function()
			humanoid.WalkSpeed = 16
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end)
	end

	if harvestPlatform then
		pcall(function()
			harvestPlatform:Destroy()
		end)

		harvestPlatform = nil
	end

	if idleConnection then
		pcall(function()
			idleConnection:Disconnect()
		end)

		idleConnection = nil
	end

	if screen and screen.Parent then
		pcall(function()
			screen:Destroy()
		end)
	end
end
