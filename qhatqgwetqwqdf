local function cleanup(lockSession)
	if State.Unloading then
		return
	end

	State.Unloading = true

	State.AutoBuy = false
	State.AutoHarvest = false
	State.AutoSell = false

	State.EmoteSpam = false
	State.AntiAFK = false

	State.Fly = false
	State.WalkSpeed = false

	pcall(
		stopFly
	)

	local humanoid =
		getHumanoid()

	if humanoid then
		pcall(function()
			humanoid.WalkSpeed = 16
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end)
	end

	destroyHarvestPlatform()

	if idleConnection then
		pcall(function()
			idleConnection:
				Disconnect()
		end)

		idleConnection = nil
	end

	if seedPromptAddedConnection then
		pcall(function()
			seedPromptAddedConnection:
				Disconnect()
		end)

		seedPromptAddedConnection = nil
	end

	if seedPromptRemovingConnection then
		pcall(function()
			seedPromptRemovingConnection:
				Disconnect()
		end)

		seedPromptRemovingConnection = nil
	end

	clearPlantConnections()

	if lockSession then
		_G.THHGrowersHardUnloaded = true
	end

	if screen and screen.Parent then
		pcall(function()
			screen:Destroy()
		end)
	end
end

