	platform.Parent = workspace

	pcall(function()
		character:PivotTo(platform.CFrame * CFrame.new(0, 3.2, 0))
	end)

	local weld = Instance.new("WeldConstraint")
	weld.Name = "GG_HarvestLock"
	weld.Part0 = platform
	weld.Part1 = root
	weld.Parent = platform

	for _, prompt in ipairs(prompts) do
		if not State.AutoHarvest then
			break
		end

		if prompt.Parent and prompt.Enabled then
			local part = promptPart(prompt)

			if part then
				platform.CFrame = part.CFrame * CFrame.new(0, -3.1, 0)
				task.wait(0.025)
				firePrompt(prompt)
				task.wait(0.025)
			end
		end
	end

	if weld then
		weld:Destroy()
	end

	if platform then
		platform:Destroy()
	end

	if character and character.Parent then
		pcall(function()
			character:PivotTo(oldPosition)
		end)
	end
