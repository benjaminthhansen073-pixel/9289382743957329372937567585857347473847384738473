	corner(valueLabel, 6)

	local track =
		Instance.new("Frame")

	track.Size =
		UDim2.new(
			1,
			-26,
			0,
			5
		)

	track.Position =
		UDim2.fromOffset(
			13,
			51
		)

	track.BackgroundColor3 =
		Color3.fromRGB(
			40,
			44,
			52
		)

	track.BorderSizePixel = 0
	track.Parent = card

	corner(track, 5)

	local percent =
		(default - minimum)
		/ (maximum - minimum)

	local fill =
		Instance.new("Frame")

	fill.Size =
		UDim2.new(
			percent,
			0,
			1,
			0
		)

	fill.BackgroundColor3 =
		Theme.Accent

	fill.BorderSizePixel = 0
	fill.Parent = track

	corner(fill, 5)

	local knob =
		Instance.new("Frame")

	knob.AnchorPoint =
		Vector2.new(
			0.5,
			0.5
		)

	knob.Size =
		UDim2.fromOffset(
			12,
			12
		)

	knob.Position =
		UDim2.new(
			percent,
			0,
			0.5,
			0
		)

	knob.BackgroundColor3 =
		Theme.Text

	knob.BorderSizePixel = 0
	knob.Parent = track

	corner(knob, 10)

	local dragging = false

	local function update(input)
		local x =
			math.clamp(
				input.Position.X
					- track.AbsolutePosition.X,

				0,

				track.AbsoluteSize.X
			)

		local pct =
			x / track.AbsoluteSize.X

		local value =
			math.floor(
				minimum
				+ (
					maximum
					- minimum
				)
				* pct
			)

		fill.Size =
			UDim2.new(
				pct,
				0,
				1,
				0
			)

		knob.Position =
			UDim2.new(
				pct,
				0,
				0.5,
				0
			)

		valueLabel.Text =
			tostring(value)

		callback(value)
	end

	track.InputBegan:
		Connect(function(input)

			if
				input.UserInputType
					== Enum.UserInputType.MouseButton1
				or input.UserInputType
					== Enum.UserInputType.Touch
			then
				dragging = true
				update(input)
			end
		end)

	UserInputService.InputChanged:
		Connect(function(input)

			if not dragging then
				return
			end

			if
				input.UserInputType
					== Enum.UserInputType.MouseMovement
				or input.UserInputType
					== Enum.UserInputType.Touch
			then
				update(input)
			end
		end)

	UserInputService.InputEnded:
		Connect(function(input)

			if
				input.UserInputType
					== Enum.UserInputType.MouseButton1
				or input.UserInputType
					== Enum.UserInputType.Touch
			then
				dragging = false
			end
		end)
end

