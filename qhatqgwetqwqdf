local function getSpawnedSeedPrompts()
	local prompts = {}

	for _, object in ipairs(workspace:GetDescendants()) do
		if
			object:IsA("ProximityPrompt")
			and object.Enabled
		then
			local action =
				string.lower(object.ActionText or "")

			local info = promptInformation(object)

			if
				string.find(action, "buy", 1, true)
				and string.find(info, "seed", 1, true)
			then
				table.insert(prompts, object)
			end
		end
	end

	return prompts
end

local function autoBuySeeds()
	local prompts = getSpawnedSeedPrompts()

	if #prompts > 0 then
		for _, prompt in ipairs(prompts) do
			if not State.AutoBuy then
				break
			end

			if prompt.Parent and prompt.Enabled then
				usePrompt(prompt)
				task.wait(0.04)
			end
		end

		return
	end

	-- fallback for games using the Grow-a-Garden style remote

	local buyRemote = getRemote("BuySeedStock")

	if not buyRemote then
		return
	end

	local seedShop

	for _, object in ipairs(playerGui:GetDescendants()) do
		if object.Name == "Seed_Shop" then
			seedShop = object
			break
		end
	end

	if not seedShop then
		return
	end

	local seeds = {}
	local used = {}

	for _, frame in ipairs(seedShop:GetDescendants()) do
		if frame.Name == "Main_Frame" then
			local seed = frame.Parent

			if seed and not used[seed] then
				local stock =
					frame:FindFirstChild(
						"Stock_Text",
						true
					)

				if
					stock
					and stock:IsA("TextLabel")
				then
					local text = stock.Text or ""

					local amount =
						tonumber(
							text:match(
								"[xX]%s*(%d+)"
							)
						)
						or tonumber(
							text:match("(%d+)")
						)
						or 0

					if amount > 0 then
						used[seed] = true

						table.insert(seeds, {
							Name = seed.Name,
							Stock = amount,
						})
					end
				end
			end
		end
	end

	for _, seed in ipairs(seeds) do
		if not State.AutoBuy then
			break
		end

		for _ = 1, seed.Stock do
			if not State.AutoBuy then
				break
			end

			pcall(function()
				buyRemote:FireServer(seed.Name)
			end)

			task.wait(0.05)
		end
	end
end

