end

local function readSeedShopStock()
	local seedShop

	for _, object in ipairs(playerGui:GetDescendants()) do
		if object.Name == "Seed_Shop" then
			seedShop = object
			break
		end
	end

	if not seedShop then
		return {}
	end

	local seeds = {}
	local used = {}

	for _, frame in ipairs(seedShop:GetDescendants()) do
		if frame.Name == "Main_Frame" then
			local seed = frame.Parent

			if seed and not used[seed] then
				local stock =
					frame:FindFirstChild(
						"Stock_Text",
						true
					)

				if
					stock
					and stock:IsA("TextLabel")
				then
					local text =
						stock.Text or ""

					local amount =
						tonumber(
							text:match(
								"[xX]%s*(%d+)"
							)
						)
						or tonumber(
							text:match(
								"(%d+)"
							)
						)
						or 0

					if amount > 0 then
						used[seed] = true

						table.insert(
							seeds,
							{
								Name = seed.Name,
								Stock = amount
							}
						)
					end
				end
			end
		end
	end

	return seeds
end

local function buySeedsRemoteFallback()
	local remote =
		getRemote("BuySeedStock")

	if not remote then
		return false
	end

	local seeds =
		readSeedShopStock()

	if #seeds == 0 then
		return false
	end

	for _, seed in ipairs(seeds) do
		if State.Unloading then
			break
		end

		for _ = 1, seed.Stock do
			if State.Unloading then
				break
			end

			pcall(function()
				remote:FireServer(
					seed.Name
				)
			end)

			task.wait(0.015)
		end
	end

	return true
end

local function buySeedPass()
	local hadPrompts = false

	for prompt in pairs(seedPrompts) do
		if prompt.Parent then
			hadPrompts = true
			break
		end
	end

	if hadPrompts then
		clickSeedPrompts()

		return true
	end

	return buySeedsRemoteFallback()
end

local buyingNow = false

local function buyAllSeedsNow()
	if buyingNow then
		return
	end

	buyingNow = true

	for pass = 1, 7 do
		if State.Unloading then
			break
		end

		buySeedPass()

		if pass < 7 then
			task.wait(0.1)
		end
	end

	buyingNow = false
end

